# VibeScan environment configuration template
# Copy to .env and customize before running `docker compose up --build`

VIBESCAN_ENVIRONMENT=production
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
VIBESCAN_SECRET_KEY=replace-with-at-least-32-chars-of-cryptographic-randomness

POSTGRES_USER=vibescan
POSTGRES_PASSWORD=vibescan_local_db_pass
POSTGRES_DB=vibescan

VIBESCAN_TASK_BACKEND=arq
VIBESCAN_COOKIE_SECURE=false

# Bootstrap administrator (created on first startup if no operators exist)
VIBESCAN_BOOTSTRAP_ADMIN_EMAIL=admin@vibescan.org
VIBESCAN_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe-StrongPass!2026

# Lab mode (Keep false in production! Enable only in an isolated lab to test local containers such as OWASP Juice Shop / WebGoat)
VIBESCAN_LAB_MODE=false
VIBESCAN_ALLOW_ATTESTATION_ONLY=false
VIBESCAN_ALLOW_PRIVATE_TARGETS=false
VIBESCAN_PRIVATE_TARGET_ALLOWLIST=

# Optional AI Security Analyst (defaults to deterministic evidence synthesizer when disabled)
VIBESCAN_AI_PROVIDER=disabled
VIBESCAN_AI_MODEL=gpt-4o-mini
VIBESCAN_AI_BASE_URL=https://api.openai.com/v1
VIBESCAN_OPENAI_API_KEY=
